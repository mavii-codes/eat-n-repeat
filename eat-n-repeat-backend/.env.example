PORT=4000
CLIENT_ORIGIN=http://localhost:3000
# Comma-separated list for multiple allowed origins:
# CLIENT_ORIGIN=http://localhost:3000,http://192.168.1.15:3000
JWT_SECRET=replace-with-a-long-random-secret

# Database (Prisma)
DATABASE_URL=mysql://root:@localhost:3306/eat_n_repeat

# Resend Email
RESEND_API_KEY=
RESEND_FROM="Eat n RepEat Cafe" <noreply@eatnrepeat.online>

# Xendit
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# SMTP (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Cloud Sync Heartbeat
# Only active when CLOUD_SYNC_URL points to a real (non-example) endpoint.
# The local backend POSTs a heartbeat to the cloud every HEARTBEAT_INTERVAL_MS.
CLOUD_SYNC_URL=https://eat-n-repeat-cloud.example.com/api/sync/push
HEARTBEAT_INTERVAL_MS=60000
