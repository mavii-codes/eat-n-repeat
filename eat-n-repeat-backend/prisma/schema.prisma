generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @map("id") @db.VarChar(64)
  name               String              @map("name") @db.VarChar(120)
  username           String              @unique @map("username") @db.VarChar(80)
  email              String              @unique @map("email") @db.VarChar(255)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  role               String              @default("staff") @map("role") @db.VarChar(50)
  status             String              @default("active") @map("status") @db.VarChar(20)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  archived           Boolean             @default(false) @map("archived")
  staffNotifications StaffNotification[]

  @@map("users")
}

model Customer {
  id                      String                   @id @map("id") @db.VarChar(64)
  name                    String                   @map("name") @db.VarChar(120)
  email                   String                   @unique @map("email") @db.VarChar(255)
  phone                   String?                  @map("phone") @db.VarChar(20)
  passwordHash            String                   @map("password_hash") @db.VarChar(255)
  status                  String                   @default("pending_verification") @map("status") @db.VarChar(30)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamp(0)
  avatarUrl               String?                  @map("avatar_url") @db.VarChar(255)
  notificationPreferences String?                  @map("notification_preferences") @db.LongText
  syncStatus              String                   @default("pending") @map("sync_status") @db.VarChar(10)
  customerAddresses       CustomerAddress[]
  customerFavorites       CustomerFavorite[]
  customerNotifications   CustomerNotification[]
  emailVerificationTokens EmailVerificationToken[]
  orders                  Order[]
  passwordResetTokens     PasswordResetToken[]

  @@map("customers")
}

model Order {
  id                    String    @id @map("id") @db.VarChar(64)
  orderNumber           String    @map("order_number") @db.VarChar(50)
  customerName          String    @map("customer_name") @db.VarChar(120)
  phone                 String?   @map("phone") @db.VarChar(20)
  address               String?   @map("address") @db.Text
  serviceAreaId         String?   @map("service_area_id") @db.VarChar(64)
  type                  String    @default("delivery") @map("type") @db.VarChar(20)
  items                 String    @map("items") @db.Text
  subtotal              Decimal   @map("subtotal") @db.Decimal(10, 2)
  deliveryFee           Decimal   @default(0.00) @map("delivery_fee") @db.Decimal(10, 2)
  total                 Decimal   @map("total") @db.Decimal(10, 2)
  status                String    @default("pending") @map("status") @db.VarChar(50)
  notes                 String?   @map("notes") @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  deliveredAt           DateTime? @map("delivered_at") @db.Timestamp(0)
  archived              Boolean   @default(false) @map("archived")
  deliveryPerson        String?   @map("delivery_person") @db.VarChar(50)
  assignedRole          String?   @map("assigned_role") @db.VarChar(50)
  assignedAt            DateTime? @map("assigned_at") @db.Timestamp(0)
  estimatedDeliveryTime String?   @default("15–25 min") @map("estimated_delivery_time") @db.VarChar(50)
  cancelledBy           String?   @map("cancelled_by") @db.VarChar(50)
  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamp(0)
  pendingAt             DateTime? @map("pending_at") @db.Timestamp(0)
  confirmedAt           DateTime? @map("confirmed_at") @db.Timestamp(0)
  preparingAt           DateTime? @map("preparing_at") @db.Timestamp(0)
  readyForDeliveryAt    DateTime? @map("ready_for_delivery_at") @db.Timestamp(0)
  outForDeliveryAt      DateTime? @map("out_for_delivery_at") @db.Timestamp(0)
  syncStatus            String    @default("pending") @map("sync_status") @db.VarChar(10)
  customerId            String?   @map("customer_id") @db.VarChar(64)
  orderMode             String    @default("online") @map("order_mode") @db.VarChar(10)
  customer              Customer? @relation(fields: [customerId], references: [id])
  payments              Payment[]

  @@index([customerId], map: "orders_customer_id_fkey")
  @@map("orders")
}

model Payment {
  id              String    @id @map("id") @db.VarChar(64)
  orderId         String    @map("order_id") @db.VarChar(64)
  paymentMethod   String    @map("payment_method") @db.VarChar(50)
  xenditInvoiceId String?   @map("xendit_invoice_id") @db.VarChar(100)
  xenditReference String?   @map("xendit_reference") @db.VarChar(100)
  amount          Decimal   @map("amount") @db.Decimal(10, 2)
  status          String    @default("PENDING") @map("status") @db.VarChar(50)
  paidAt          DateTime? @map("paid_at") @db.Timestamp(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  syncStatus      String    @default("pending") @map("sync_status") @db.VarChar(10)
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "payments_order_id_fkey")
  @@map("payments")
}

model CustomerNotification {
  id          String   @id @map("id") @db.VarChar(64)
  customerId  String   @map("customer_id") @db.VarChar(64)
  type        String   @map("type") @db.VarChar(20)
  title       String   @map("title") @db.VarChar(255)
  description String   @map("description") @db.Text
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "customer_notifications_customer_id_fkey")
  @@map("customer_notifications")
}

model CustomerFavorite {
  customerId String   @map("customer_id") @db.VarChar(64)
  menuItemId String   @map("menu_item_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([customerId, menuItemId])
  @@map("customer_favorites")
}

model CustomerAddress {
  id            String   @id @map("id") @db.VarChar(64)
  customerId    String   @map("customer_id") @db.VarChar(64)
  addressName   String   @map("address_name") @db.VarChar(100)
  fullAddress   String   @map("full_address") @db.VarChar(255)
  barangay      String   @map("barangay") @db.VarChar(100)
  municipality  String   @map("municipality") @db.VarChar(100)
  landmarks     String?  @map("landmarks") @db.VarChar(255)
  deliveryNotes String?  @map("delivery_notes") @db.VarChar(255)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "customer_addresses_customer_id_fkey")
  @@map("customer_addresses")
}

model StaffNotification {
  id             String   @id @map("id") @db.VarChar(64)
  userId         String   @map("user_id") @db.VarChar(64)
  type           String   @map("type") @db.VarChar(50)
  title          String   @map("title") @db.VarChar(255)
  message        String   @map("message") @db.Text
  relatedOrderId String?  @map("related_order_id") @db.VarChar(64)
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  syncStatus     String   @default("pending") @map("sync_status") @db.VarChar(10)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "staff_notifications_user_id_fkey")
  @@map("staff_notifications")
}

model StockCategory {
  id         String      @id @map("id") @db.VarChar(64)
  name       String      @unique @map("name") @db.VarChar(120)
  stockItems StockItem[]

  @@map("stock_categories")
}

model StockItem {
  id                String        @id @map("id") @db.VarChar(64)
  name              String        @map("name") @db.VarChar(160)
  categoryId        String        @map("category_id") @db.VarChar(64)
  quantity          Decimal       @default(0.00) @map("quantity") @db.Decimal(10, 2)
  unit              String        @map("unit") @db.VarChar(30)
  lowStockThreshold Decimal       @default(5.00) @map("low_stock_threshold") @db.Decimal(10, 2)
  category          StockCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "stock_items_category_id_fkey")
  @@map("stock_items")
}

model StockRequest {
  id              String   @id @map("id") @db.VarChar(64)
  staffId         String   @map("staff_id") @db.VarChar(64)
  staffName       String   @map("staff_name") @db.VarChar(120)
  ingredientId    String   @map("ingredient_id") @db.VarChar(64)
  ingredientName  String   @map("ingredient_name") @db.VarChar(160)
  currentQuantity Decimal  @map("current_quantity") @db.Decimal(10, 2)
  unit            String   @map("unit") @db.VarChar(30)
  threshold       Decimal  @map("threshold") @db.Decimal(10, 2)
  status          String   @default("Pending") @map("status") @db.VarChar(20)
  message         String?  @map("message") @db.Text
  adminNote       String?  @map("admin_note") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("stock_requests")
}

model OfflineStockTransaction {
  id               String   @id @map("id") @db.VarChar(64)
  stockItemId      String   @map("stock_item_id") @db.VarChar(255)
  quantityDeducted Decimal  @map("quantity_deducted") @db.Decimal(10, 2)
  orderId          String   @map("order_id") @db.VarChar(64)
  staffId          String   @map("staff_id") @db.VarChar(64)
  transactionDate  DateTime @default(now()) @map("transaction_date") @db.Timestamp(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("offline_stock_transactions")
}

model EmailVerificationToken {
  id         String   @id @map("id") @db.VarChar(64)
  customerId String   @map("customer_id") @db.VarChar(64)
  tokenHash  String   @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime @default(now()) @map("expires_at") @db.Timestamp(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  attempts   Int      @default(0) @map("attempts")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "email_verification_tokens_customer_id_fkey")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String   @id @map("id") @db.VarChar(64)
  customerId String   @map("customer_id") @db.VarChar(64)
  tokenHash  String   @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime @default(now()) @map("expires_at") @db.Timestamp(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  attempts   Int      @default(0) @map("attempts")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "password_reset_tokens_customer_id_fkey")
  @@map("password_reset_tokens")
}

model Addon {
  id        String   @id @map("id") @db.VarChar(64)
  name      String   @map("name") @db.VarChar(120)
  price     Decimal  @map("price") @db.Decimal(10, 2)
  available Boolean  @default(true) @map("available")
  image     String?  @db.MediumText @map("image")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("addons")
}

model CashShift {
  id               String            @id @map("id") @db.VarChar(64)
  staffId          String            @map("staff_id") @db.VarChar(64)
  staffName        String            @map("staff_name") @db.VarChar(120)
  startTime        DateTime          @default(now()) @map("start_time") @db.Timestamp(0)
  endTime          DateTime?         @map("end_time") @db.Timestamp(0)
  startingFloat    Decimal           @map("starting_float") @db.Decimal(10, 2)
  expectedCash     Decimal           @map("expected_cash") @db.Decimal(10, 2)
  actualCash       Decimal?          @map("actual_cash") @db.Decimal(10, 2)
  difference       Decimal?          @map("difference") @db.Decimal(10, 2)
  status           String            @default("open") @map("status") @db.VarChar(20)
  cashTransactions CashTransaction[]

  @@map("cash_shifts")
}

model CashTransaction {
  id        String    @id @map("id") @db.VarChar(64)
  shiftId   String    @map("shift_id") @db.VarChar(64)
  orderId   String?   @map("order_id") @db.VarChar(64)
  type      String    @default("sale") @map("type") @db.VarChar(30)
  amount    Decimal   @map("amount") @db.Decimal(10, 2)
  timestamp DateTime  @default(now()) @map("timestamp") @db.Timestamp(0)
  adminId   String?   @map("admin_id") @db.VarChar(64)
  adminName String?   @map("admin_name") @db.VarChar(120)
  reason    String?   @map("reason") @db.VarChar(255)
  shift     CashShift @relation(fields: [shiftId], references: [id])

  @@index([shiftId], map: "cash_transactions_shift_id_fkey")
  @@index([shiftId], map: "cash_tx_shift_fk")
  @@map("cash_transactions")
}

model CafeStatus {
  id              Int       @id @default(1)
  onlineOrdering  String    @default("AVAILABLE") @map("online_ordering") @db.VarChar(30)
  lastHeartbeatAt DateTime? @map("last_heartbeat_at") @db.Timestamp(0)
  forceOverride   String?   @map("force_override") @db.VarChar(30)
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("cafe_status")
}

/// Single-row record of the last Online → Local menu pull. Written only by
/// the menu-pull service on this instance. Additive table; auto-migrates via
/// `prisma db push` on both local bootstrap and Render builds.
model MenuSyncState {
  id           Int       @id @default(1)
  lastPulledAt DateTime? @map("last_pulled_at") @db.Timestamp(0)
  lastResult   String?   @map("last_result") @db.VarChar(255)
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("menu_sync_state")
}

model MenuCategory {
  id          String     @id @map("id") @db.VarChar(64)
  name        String     @map("name") @db.VarChar(120)
  description String?    @map("description") @db.VarChar(255)
  archived    Boolean    @default(false) @map("archived")
  archivedAt  DateTime?  @map("archived_at") @db.Timestamp(0)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime   @updatedAt @map("updated_at")
  items       MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id          String       @id @map("id") @db.VarChar(64)
  name        String       @map("name") @db.VarChar(160)
  description String?      @map("description") @db.Text
  price       Decimal      @map("price") @db.Decimal(10, 2)
  categoryId  String       @map("category_id") @db.VarChar(64)
  available   Boolean      @default(true) @map("available")
  image       String?      @map("image") @db.MediumText
  archived    Boolean      @default(false) @map("archived")
  archivedAt  DateTime?    @map("archived_at") @db.Timestamp(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime     @updatedAt @map("updated_at")
  sizes       String?      @map("sizes") @db.LongText
  category    MenuCategory @relation(fields: [categoryId], references: [id])

  @@index([categoryId], map: "menu_items_category_id_fkey")
  @@map("menu_items")
}
