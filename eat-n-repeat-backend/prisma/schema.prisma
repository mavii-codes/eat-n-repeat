generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @db.VarChar(64) @map("id")
  name              String              @db.VarChar(120) @map("name")
  username          String              @unique @db.VarChar(80) @map("username")
  email             String              @unique @db.VarChar(255) @map("email")
  passwordHash      String              @db.VarChar(255) @map("password_hash")
  role              String              @default("staff") @db.VarChar(50) @map("role")
  status            String              @default("active") @db.VarChar(20) @map("status")
  archived          Boolean             @default(false) @map("archived")
  createdAt         DateTime            @default(now()) @db.Timestamp(0) @map("created_at")
  // Phase 2 account security: forced first-login password change + last sign-in.
  mustChangePassword Boolean            @default(false) @map("must_change_password")
  lastLoginAt       DateTime?           @db.Timestamp(0) @map("last_login_at")
  // Default opening cash float for this staff member (set by admin)
  defaultOpeningFloat Decimal?          @db.Decimal(10, 2) @map("default_opening_float")

  staffNotifications StaffNotification[]

  @@map("users")
}

model Customer {
  id                      String                    @id @db.VarChar(64) @map("id")
  name                    String                    @db.VarChar(120) @map("name")
  email                   String                    @unique @db.VarChar(255) @map("email")
  phone                   String?                   @db.VarChar(20) @map("phone")
  passwordHash            String                    @db.VarChar(255) @map("password_hash")
  status                  String                    @default("pending_verification") @db.VarChar(30) @map("status")
  avatarUrl               String?                   @db.VarChar(255) @map("avatar_url")
  notificationPreferences Json?                     @db.Json @map("notification_preferences")
  syncStatus              String                    @default("pending") @db.VarChar(10) @map("sync_status")
  createdAt               DateTime                  @default(now()) @db.Timestamp(0) @map("created_at")
  // Phase 2 account security: last successful customer sign-in.
  lastLoginAt             DateTime?                 @db.Timestamp(0) @map("last_login_at")

  orders                  Order[]
  customerNotifications   CustomerNotification[]
  customerFavorites       CustomerFavorite[]
  customerAddresses       CustomerAddress[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("customers")
}

model Order {
  id                    String    @id @db.VarChar(64) @map("id")
  orderNumber           String    @db.VarChar(50) @map("order_number")
  customerId            String?   @db.VarChar(64) @map("customer_id")
  customer              Customer? @relation(fields: [customerId], references: [id])
  customerName          String    @db.VarChar(120) @map("customer_name")
  phone                 String?   @db.VarChar(20) @map("phone")
  address               String?   @db.Text @map("address")
  serviceAreaId         String?   @db.VarChar(64) @map("service_area_id")
  type                  String    @default("delivery") @db.VarChar(20) @map("type")
  items                 String    @db.Text @map("items")
  subtotal              Decimal   @db.Decimal(10, 2) @map("subtotal")
  deliveryFee           Decimal   @default(0) @db.Decimal(10, 2) @map("delivery_fee")
  total                 Decimal   @db.Decimal(10, 2) @map("total")
  // Promo codes: order-level discount applied to the item subtotal,
  // computed SERVER-side at checkout (the client only ever sends the code).
  // All three stay null/0 for legacy orders and orders without a code.
  promoCode             String?   @db.VarChar(20) @map("promo_code")
  subtotalBeforeDiscount Decimal? @db.Decimal(10, 2) @map("subtotal_before_discount")
  discountAmount        Decimal   @default(0) @db.Decimal(10, 2) @map("discount_amount")
  status                String    @default("pending") @db.VarChar(50) @map("status")
  deliveryPerson        String?   @db.VarChar(50) @map("delivery_person")
  assignedRole          String?   @db.VarChar(50) @map("assigned_role")
  assignedAt            DateTime? @db.Timestamp(0) @map("assigned_at")
  estimatedDeliveryTime String?   @default("15–25 min") @db.VarChar(50) @map("estimated_delivery_time")
  notes                 String?   @db.Text @map("notes")
  // Pick-Up / Take-Out details (null for delivery, dine-in, and legacy rows).
  // pickupName: who collects the order (2-60 letters/spaces/.-'), pickupAt:
  // promised collection time (UTC; displayed in Asia/Manila).
  pickupName            String?   @db.VarChar(60) @map("pickup_name")
  pickupAt              DateTime? @db.Timestamp(0) @map("pickup_at")
  createdAt             DateTime  @default(now()) @db.Timestamp(0) @map("created_at")
  deliveredAt           DateTime? @db.Timestamp(0) @map("delivered_at")
  archived              Boolean   @default(false) @map("archived")
  cancelledBy           String?   @db.VarChar(50) @map("cancelled_by")
  cancelledAt           DateTime? @db.Timestamp(0) @map("cancelled_at")
  pendingAt             DateTime? @db.Timestamp(0) @map("pending_at")
  confirmedAt           DateTime? @db.Timestamp(0) @map("confirmed_at")
  preparingAt           DateTime? @db.Timestamp(0) @map("preparing_at")
  readyForDeliveryAt    DateTime? @db.Timestamp(0) @map("ready_for_delivery_at")
  outForDeliveryAt      DateTime? @db.Timestamp(0) @map("out_for_delivery_at")
  orderMode             String    @default("online") @db.VarChar(10) @map("order_mode")
  syncStatus            String    @default("pending") @db.VarChar(10) @map("sync_status")

  payments Payment[]

  @@map("orders")
  @@index([customerId], map: "orders_customer_id_fkey")
}

model Payment {
  id              String    @id @db.VarChar(64) @map("id")
  orderId         String    @db.VarChar(64) @map("order_id")
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod   String    @db.VarChar(50) @map("payment_method")
  xenditInvoiceId String?   @db.VarChar(100) @map("xendit_invoice_id")
  xenditReference String?   @db.VarChar(100) @map("xendit_reference")
  amount          Decimal   @db.Decimal(10, 2) @map("amount")
  status          String    @default("PENDING") @db.VarChar(50) @map("status")
  paidAt          DateTime? @db.Timestamp(0) @map("paid_at")
  syncStatus      String    @default("pending") @db.VarChar(10) @map("sync_status")
  createdAt       DateTime  @default(now()) @db.Timestamp(0) @map("created_at")

  @@map("payments")
  @@index([orderId], map: "payments_order_id_fkey")
}

model CustomerNotification {
  id          String   @id @db.VarChar(64) @map("id")
  customerId  String   @db.VarChar(64) @map("customer_id")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        String   @db.VarChar(20) @map("type")
  title       String   @db.VarChar(255) @map("title")
  description String   @db.Text @map("description")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@map("customer_notifications")
  @@index([customerId], map: "customer_notifications_customer_id_fkey")
}

model CustomerFavorite {
  customerId String   @db.VarChar(64) @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  menuItemId String   @db.VarChar(64) @map("menu_item_id")
  createdAt  DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@id([customerId, menuItemId])
  @@map("customer_favorites")
}

model CustomerAddress {
  id            String   @id @db.VarChar(64) @map("id")
  customerId    String   @db.VarChar(64) @map("customer_id")
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addressName   String   @db.VarChar(100) @map("address_name")
  fullAddress   String   @db.VarChar(255) @map("full_address")
  barangay      String   @db.VarChar(100) @map("barangay")
  municipality  String   @db.VarChar(100) @map("municipality")
  landmarks     String?  @db.VarChar(255) @map("landmarks")
  deliveryNotes String?  @db.VarChar(255) @map("delivery_notes")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@map("customer_addresses")
  @@index([customerId], map: "customer_addresses_customer_id_fkey")
}

model StaffNotification {
  id             String   @id @db.VarChar(64) @map("id")
  userId         String   @db.VarChar(64) @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String   @db.VarChar(50) @map("type")
  title          String   @db.VarChar(255) @map("title")
  message        String   @db.Text @map("message")
  relatedOrderId String?  @db.VarChar(64) @map("related_order_id")
  isRead         Boolean  @default(false) @map("is_read")
  syncStatus     String   @default("pending") @db.VarChar(10) @map("sync_status")
  createdAt      DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@map("staff_notifications")
  @@index([userId], map: "staff_notifications_user_id_fkey")
}

model StockCategory {
  id         String      @id @db.VarChar(64) @map("id")
  name       String      @unique @db.VarChar(120) @map("name")
  stockItems StockItem[]

  @@map("stock_categories")
}

model StockItem {
  id                String        @id @db.VarChar(64) @map("id")
  // Unique (case-insensitive via the column collation; trimmed in the service).
  name              String        @unique(map: "stock_items_name_key") @db.VarChar(160) @map("name")
  categoryId        String        @db.VarChar(64) @map("category_id")
  category          StockCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  quantity          Decimal       @default(0) @db.Decimal(10, 2) @map("quantity")
  unit              String        @db.VarChar(30) @map("unit")
  lowStockThreshold Decimal       @default(5) @db.Decimal(10, 2) @map("low_stock_threshold")
  /// "ingredient" (created from Inventory) or "menu" (auto-created/linked with a
  /// menu item). Drives labeling and the Menu-item link report — it is NOT used
  /// to filter anything by itself.
  kind              String        @default("ingredient") @db.VarChar(20) @map("kind")
  /// Archive = hidden from dashboard/pickers/counts, but movements/history are
  /// preserved. Movement rows are never mutated or deleted by archiving.
  archived          Boolean       @default(false) @map("archived")
  archivedAt        DateTime?     @db.Timestamp(0) @map("archived_at")

  @@map("stock_items")
  @@index([categoryId], map: "stock_items_category_id_fkey")
}

model StockRequest {
  id              String   @id @db.VarChar(64) @map("id")
  staffId         String   @db.VarChar(64) @map("staff_id")
  staffName       String   @db.VarChar(120) @map("staff_name")
  ingredientId    String   @db.VarChar(64) @map("ingredient_id")
  ingredientName  String   @db.VarChar(160) @map("ingredient_name")
  currentQuantity Decimal  @db.Decimal(10, 2) @map("current_quantity")
  unit            String   @db.VarChar(30) @map("unit")
  threshold       Decimal  @db.Decimal(10, 2) @map("threshold")
  status          String   @default("Pending") @db.VarChar(20) @map("status")
  message         String?  @db.Text @map("message")
  adminNote       String?  @db.Text @map("admin_note")
  createdAt       DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@map("stock_requests")
}

model OfflineStockTransaction {
  id               String   @id @db.VarChar(64) @map("id")
  stockItemId      String   @db.VarChar(255) @map("stock_item_id")
  quantityDeducted Decimal  @db.Decimal(10, 2) @map("quantity_deducted")
  orderId          String   @db.VarChar(64) @map("order_id")
  staffId          String   @db.VarChar(64) @map("staff_id")
  transactionDate  DateTime @db.Timestamp(0) @map("transaction_date")
  createdAt        DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@map("offline_stock_transactions")
}

model StockMovement {
  id             String    @id @db.VarChar(64) @map("id")
  stockItemId    String    @db.VarChar(64) @map("stock_item_id")
  itemName       String    @db.VarChar(160) @map("item_name")
  type           String    @db.VarChar(40) @map("type")
  quantityChange Decimal   @db.Decimal(10, 2) @map("quantity_change")
  balanceBefore  Decimal   @db.Decimal(10, 2) @map("balance_before")
  balanceAfter   Decimal   @db.Decimal(10, 2) @map("balance_after")
  unitCost       Decimal?  @db.Decimal(10, 2) @map("unit_cost")
  totalCost      Decimal?  @db.Decimal(10, 2) @map("total_cost")
  reason         String?   @db.VarChar(120)
  reference      String?   @db.VarChar(255)
  receivedAt     DateTime? @db.Timestamp(0) @map("received_at")
  expiryDate     DateTime? @db.Timestamp(0) @map("expiry_date")
  createdById    String    @db.VarChar(64) @map("created_by_id")
  createdByName  String    @db.VarChar(120) @map("created_by_name")
  createdAt      DateTime  @default(now()) @db.Timestamp(3) @map("created_at")

  @@index([stockItemId], map: "idx_stock_movements_stock_item_id")
  @@index([createdAt], map: "idx_stock_movements_created_at")
  @@index([createdById], map: "idx_stock_movements_created_by_id")
  @@map("stock_movements")
}

/// Phase B FIFO cost layers. One row per STOCK_IN (and opening/backfill/
/// residual heal). Plain scalar stockItemId — NO database-level foreign key,
/// same convention as StockMovement. Consumption walks created_at ASC, id ASC.
model StockLayer {
  id          String    @id @db.VarChar(64) @map("id")
  stockItemId String    @db.VarChar(64) @map("stock_item_id")
  /// Cost per remaining unit in this layer. Null = uncosted stock.
  unitCost    Decimal?  @db.Decimal(10, 2) @map("unit_cost")
  remaining   Decimal   @default(0) @db.Decimal(10, 2) @map("remaining")
  /// Linked movement id ("sm-..."), or "opening" / "residual".
  sourceRef   String?   @db.VarChar(64) @map("source_ref")
  /// Phase B quantity/date metadata copied from the source STOCK_IN movement.
  receivedAt       DateTime? @db.Timestamp(0) @map("received_at")
  expiryDate       DateTime? @db.Timestamp(0) @map("expiry_date")
  quantityReceived Decimal?  @db.Decimal(10, 2) @map("quantity_received")
  /// True for the opening-balance layer (learned from sourceRef "opening").
  isOpening        Boolean   @default(false) @map("is_opening")
  /// Source movement id ("sm-..."), when this layer came from a movement.
  sourceMovementId String?   @db.VarChar(64) @map("source_movement_id")
  createdAt   DateTime  @default(now()) @db.Timestamp(3) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamp(3) @map("updated_at")

  @@index([stockItemId], map: "idx_stock_layers_stock_item_id")
  @@index([expiryDate], map: "idx_stock_layers_expiry_date")
  @@map("stock_layers")
}

/// Café expense ledger. Drawer-origin rows are paid out of an open cash shift
/// (expected_cash decreases); admin non-drawer rows are bookkeeping only.
/// Reversals are additive rows linked by reversalOfId (never hard deletes);
/// voided rows stay visible and are excluded from money totals.
model Expense {
  id            String    @id @db.VarChar(64) @map("id")
  source        String    @default("drawer") @db.VarChar(20) @map("source")
  paymentSource String    @default("cash_drawer") @db.VarChar(20) @map("payment_source")
  shiftId       String?   @db.VarChar(64) @map("shift_id")
  category      String    @db.VarChar(40) @map("category")
  amount        Decimal   @db.Decimal(10, 2) @map("amount")
  reason        String    @db.VarChar(500) @map("reason")
  note          String?   @db.VarChar(1000) @map("note")
  payee         String?   @db.VarChar(120) @map("payee")
  status        String    @default("active") @db.VarChar(20) @map("status")
  voidReason    String?   @db.VarChar(500) @map("void_reason")
  voidedById    String?   @db.VarChar(64) @map("voided_by_id")
  voidedByName  String?   @db.VarChar(120) @map("voided_by_name")
  voidedAt      DateTime? @db.Timestamp(0) @map("voided_at")
  reversalOfId  String?   @db.VarChar(64) @map("reversal_of_id")
  // Explicit default: MariaDB rejects a non-first TIMESTAMP NOT NULL column
  // without one when explicit_defaults_for_timestamp is OFF. Services always
  // pass the PH-normalized date explicitly.
  expenseDate   DateTime  @default(now()) @db.Timestamp(0) @map("expense_date")
  createdById   String    @db.VarChar(64) @map("created_by_id")
  createdByName String    @db.VarChar(120) @map("created_by_name")
  createdByRole String    @db.VarChar(30) @map("created_by_role")
  createdAt     DateTime  @default(now()) @db.Timestamp(3) @map("created_at")

  @@index([shiftId], map: "idx_expenses_shift_id")
  @@index([status, expenseDate], map: "idx_expenses_status_date")
  @@index([createdById], map: "idx_expenses_created_by")
  @@map("expenses")
}

model EmailVerificationToken {
  id         String   @id @db.VarChar(64) @map("id")
  customerId String   @db.VarChar(64) @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String   @db.VarChar(255) @map("token_hash")
  expiresAt  DateTime @db.Timestamp(0) @map("expires_at")
  // Wrong-code attempts against the latest row. New codes start at 0
  // (old rows are deleted on resend), so no extra table is needed.
  attempts   Int      @default(0) @map("attempts")
  createdAt  DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@map("email_verification_tokens")
  @@index([customerId], map: "email_verification_tokens_customer_id_fkey")
}

model PasswordResetToken {
  id         String   @id @db.VarChar(64) @map("id")
  customerId String   @db.VarChar(64) @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String   @db.VarChar(255) @map("token_hash")
  expiresAt  DateTime @db.Timestamp(0) @map("expires_at")
  // Wrong-code attempts against the latest row (see EmailVerificationToken).
  attempts   Int      @default(0) @map("attempts")
  createdAt  DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@map("password_reset_tokens")
  @@index([customerId], map: "password_reset_tokens_customer_id_fkey")
}

model Addon {
  id        String   @id @db.VarChar(64) @map("id")
  name      String   @db.VarChar(120) @map("name")
  price     Decimal  @db.Decimal(10, 2) @map("price")
  available Boolean  @default(true) @map("available")
  // Optional photo (data URL or remote URL, same convention as menu
  // items). Null = customer cards render the shared fallback art.
  image     String?  @db.MediumText @map("image")
  createdAt DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@map("addons")
}

model CashShift {
  id              String            @id @db.VarChar(64) @map("id")
  staffId         String            @db.VarChar(64) @map("staff_id")
  staffName       String            @db.VarChar(120) @map("staff_name")
  startTime       DateTime          @db.Timestamp(0) @map("start_time")
  endTime         DateTime?         @db.Timestamp(0) @map("end_time")
  startingFloat   Decimal           @db.Decimal(10, 2) @map("starting_float")
  expectedCash    Decimal           @db.Decimal(10, 2) @map("expected_cash")
  actualCash      Decimal?          @db.Decimal(10, 2) @map("actual_cash")
  difference      Decimal?          @db.Decimal(10, 2) @map("difference")
  status          String            @default("open") @db.VarChar(20) @map("status")
  // End-of-shift reconciliation notes entered by the cashier.
  notes           String?           @db.Text @map("notes")
  // Admin audit: who verified/signed off, when, and the outcome.
  // 'unverified' (default) | 'verified' | 'flagged'. Staff can never
  // verify their own shift (enforced in the service, not just the UI).
  verificationStatus String       @default("unverified") @db.VarChar(20) @map("verification_status")
  verifiedBy      String?           @db.VarChar(64) @map("verified_by")
  verifiedAt      DateTime?         @db.Timestamp(0) @map("verified_at")
  flagReason      String?           @db.VarChar(255) @map("flag_reason")
  cashTransactions CashTransaction[]

  @@map("cash_shifts")
}

model CashTransaction {
  id        String    @id @db.VarChar(64) @map("id")
  shiftId   String    @db.VarChar(64) @map("shift_id")
  shift     CashShift @relation(fields: [shiftId], references: [id])
  orderId   String?   @db.VarChar(64) @map("order_id")
  type      String    @default("sale") @db.VarChar(30) @map("type")
  amount    Decimal   @db.Decimal(10, 2) @map("amount")
  adminId   String?   @db.VarChar(64) @map("admin_id")
  adminName String?   @db.VarChar(120) @map("admin_name")
  reason    String?   @db.VarChar(255) @map("reason")
  timestamp DateTime  @db.Timestamp(0) @map("timestamp")

  @@map("cash_transactions")
  @@index([shiftId], map: "cash_transactions_shift_id_fkey")
}

model CafeStatus {
  id                Int       @id @default(1)
  onlineOrdering    String    @default("AVAILABLE") @db.VarChar(30) @map("online_ordering")
  lastHeartbeatAt   DateTime? @db.Timestamp(0) @map("last_heartbeat_at")
  forceOverride     String?   @db.VarChar(30) @map("force_override")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("cafe_status")
}

/// Single-row record of the last Online → Local menu pull. Written only by
/// the menu-pull service on this instance. Additive table; auto-migrates via
/// `prisma db push` on both local bootstrap and Render builds.
model MenuSyncState {
  id           Int       @id @default(1)
  lastPulledAt DateTime? @db.Timestamp(0) @map("last_pulled_at")
  lastResult   String?   @db.VarChar(255) @map("last_result")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("menu_sync_state")
}

model MenuCategory {
  id          String     @id @db.VarChar(64) @map("id")
  name        String     @db.VarChar(120) @map("name")
  description String?    @db.VarChar(255) @map("description")
  archived    Boolean    @default(false) @map("archived")
  archivedAt  DateTime?  @db.Timestamp(0) @map("archived_at")
  createdAt   DateTime   @default(now()) @db.Timestamp(0) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  items       MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id          String       @id @db.VarChar(64) @map("id")
  name        String       @db.VarChar(160) @map("name")
  description String?      @db.Text @map("description")
  price       Decimal      @db.Decimal(10, 2) @map("price")
  categoryId  String       @db.VarChar(64) @map("category_id")
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  available   Boolean      @default(true) @map("available")
  image       String?      @db.MediumText @map("image")
  // Optional size options [{name, price}] as JSON. Absent/empty = single
  // base-price item. Render runs `prisma db push` on deploy, so this
  // nullable column migrates itself on existing databases.
  sizes       Json?        @map("sizes")
  archived    Boolean      @default(false) @map("archived")
  archivedAt  DateTime?    @db.Timestamp(0) @map("archived_at")
  createdAt   DateTime     @default(now()) @db.Timestamp(0) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  // Explicit menu → inventory link. Plain scalar + unique index (no DB-level FK,
  // same convention as the other stock_item_id columns); validated in the
  // service layer and by the read-only consistency check. NONE = not tracked.
  stockItemId String?      @unique(map: "menu_items_stock_item_id_key") @db.VarChar(64) @map("stock_item_id")
  stockMode   String       @default("NONE") @db.VarChar(10) @map("stock_mode")

  @@map("menu_items")
  @@index([categoryId], map: "menu_items_category_id_fkey")
}

/// Customer ratings + comments per menu item. GLOBAL data: aggregates and
/// the visible review list are computed over ALL rows for a menuItemId
/// (hidden=false only) — never filtered by customer. customerId is kept for
/// ownership (edit/delete own), myRating/hasReviewed, and duplicate-review
/// prevention (@@unique on [menuItemId, customerId] = one review per
/// customer per item). Plain scalars on purpose: NO database-level foreign
/// keys (same ER_CANT_CREATE_TABLE precedent as OrderChatMessage); the
/// service validates menu item + customer existence instead. Never expose
/// emails/tokens through review payloads — only the display name snapshot.
model MenuReview {
  id           String   @id @db.VarChar(64) @map("id")
  menuItemId   String   @db.VarChar(64) @map("menu_item_id")
  customerId   String   @db.VarChar(64) @map("customer_id")
  customerName String   @db.VarChar(120) @map("customer_name")
  rating       Int      @map("rating")
  comment      String?  @db.Text @map("comment")
  orderId      String?  @db.VarChar(64) @map("order_id")
  hidden       Boolean  @default(false) @map("hidden")
  createdAt    DateTime @default(now()) @db.Timestamp(0) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("menu_reviews")
  @@unique([menuItemId, customerId], map: "menu_reviews_item_customer_unique")
  @@index([menuItemId], map: "menu_reviews_menu_item_id_idx")
  @@index([customerId], map: "menu_reviews_customer_id_idx")
  @@index([orderId], map: "menu_reviews_order_id_idx")
}

/// Audit trail for admin-only customer mobile-number changes (Phase 3).
/// No authenticated customer endpoint can write here. Plain scalars, no
/// database-level foreign keys (same ER_CANT_CREATE_TABLE precedent as
/// OrderChatMessage / MenuReview).
model CustomerPhoneChangeLog {
  id            String   @id @db.VarChar(64) @map("id")
  customerId    String   @db.VarChar(64) @map("customer_id")
  customerEmail String   @db.VarChar(255) @map("customer_email")
  oldPhone      String?  @db.VarChar(20) @map("old_phone")
  newPhone      String   @db.VarChar(20) @map("new_phone")
  changedBy     String   @db.VarChar(64) @map("changed_by")
  changedByName String   @db.VarChar(120) @map("changed_by_name")
  createdAt     DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@map("customer_phone_change_log")
  @@index([customerId], map: "customer_phone_change_log_customer_id_idx")
}

/// Phase 2 admin audit trail for user-management / account-security actions.
/// Plain scalar actor/target ids (no database-level foreign keys), same
/// precedent as CustomerPhoneChangeLog. Never stores passwords or hashes.
model UserActivityLog {
  id         String   @id @db.VarChar(64) @map("id")
  actorId    String   @db.VarChar(64) @map("actor_id")
  actorName  String   @db.VarChar(120) @map("actor_name")
  action     String   @db.VarChar(60) @map("action")
  targetType String   @db.VarChar(20) @map("target_type")
  targetId   String?  @db.VarChar(64) @map("target_id")
  targetName String?  @db.VarChar(160) @map("target_name")
  meta       Json?    @map("meta")
  createdAt  DateTime @default(now()) @db.Timestamp(3) @map("created_at")

  @@index([createdAt], map: "user_activity_logs_created_at_idx")
  @@index([targetType, targetId], map: "user_activity_logs_target_idx")
  @@map("user_activity_logs")
}

/// Phase 3 customer-flagging queue for admin review. customerId is a plain
/// scalar on purpose (NO database-level foreign key, no cascade): historical
/// flags must survive a customer deletion, same precedent as
/// CustomerPhoneChangeLog / UserActivityLog. One OPEN row per customer is
/// enforced in the service (auto-flags skip silently; staff reports 409).
model CustomerFlag {
  id            String    @id @db.VarChar(64) @map("id")
  customerId    String    @db.VarChar(64) @map("customer_id")
  status        String    @default("open") @db.VarChar(20) @map("status")
  outcome       String    @default("pending") @db.VarChar(20) @map("outcome")
  reason        String    @db.Text @map("reason")
  flaggedByKind String    @db.VarChar(10) @map("flagged_by_kind")
  flaggedById   String?   @db.VarChar(64) @map("flagged_by_id")
  flaggedByName String?   @db.VarChar(120) @map("flagged_by_name")
  rule          String?   @db.VarChar(40) @map("rule")
  meta          Json?     @map("meta")
  flaggedAt     DateTime  @default(now()) @db.Timestamp(0) @map("flagged_at")
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamp(3) @map("updated_at")
  resolvedById  String?   @db.VarChar(64) @map("resolved_by_id")
  resolvedByName String?  @db.VarChar(120) @map("resolved_by_name")
  resolvedAt    DateTime? @db.Timestamp(0) @map("resolved_at")

  @@index([customerId, status], map: "customer_flags_customer_status_idx")
  @@index([status], map: "customer_flags_status_idx")
  @@map("customer_flags")
}

/// Order-scoped chat messages (customer <-> staff/rider). orderId is a
/// plain scalar on purpose: NO database-level foreign key. Render's MySQL
/// has a history of ER_CANT_CREATE_TABLE on FK creation (see 91646d2), and
/// all queries filter by orderId directly, so a real FK buys nothing here.
/// Orphan rows (order deleted) are harmless: they are keyed by orderId and
/// never surfaced once the order is gone.
model OrderChatMessage {
  id          String   @id @db.VarChar(64) @map("id")
  orderId     String   @db.VarChar(64) @map("order_id")
  senderId    String   @db.VarChar(64) @map("sender_id")
  senderRole  String   @db.VarChar(20) @map("sender_role") // "customer" | "staff"
  message     String   @db.Text @map("message")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@map("order_chat_messages")
  @@index([orderId], map: "order_chat_messages_order_id_fkey")
  @@index([senderId], map: "order_chat_messages_sender_id_fkey")
}

/// Promo codes: owner-managed discounts applied server-side to the item
/// subtotal. code is stored uppercase (4-20 chars A-Z0-9) and uniqueness /
/// pricing / limits are enforced in the service, not just the DB. promoId /
/// orderId / customerId are plain scalars on purpose (NO database-level
/// foreign keys, same ER_CANT_CREATE_TABLE precedent as MenuReview /
/// UserActivityLog); deletion rules live in the service: used codes can
/// never be hard-deleted, only paused.
model PromoCode {
  id        String    @id @db.VarChar(64) @map("id")
  code      String    @unique @db.VarChar(20) @map("code")
  description String? @db.VarChar(500) @map("description")
  type      String    @db.VarChar(10) @map("type") // "PERCENT" | "FIXED"
  value     Decimal   @db.Decimal(10, 2) @map("value") // percent number or ₱ amount
  maxDiscount Decimal? @db.Decimal(10, 2) @map("max_discount") // PERCENT-only cap in ₱
  minOrder  Decimal   @default(0) @db.Decimal(10, 2) @map("min_order")
  startsAt  DateTime  @db.Timestamp(0) @map("starts_at")
  endsAt    DateTime? @db.Timestamp(0) @map("ends_at")
  // Total order-level usage limit (null = unlimited). usageCount tracks
  // non-RELEASED redemptions and is maintained under row locks at checkout.
  totalLimit Int?     @map("total_limit")
  oncePerCustomer Boolean @default(false) @map("per_customer_limit_once")
  audience  String    @default("EVERYONE") @db.VarChar(20) @map("audience") // "EVERYONE" | "LOGGED_IN"
  channel   String    @default("BOTH") @db.VarChar(10) @map("channel") // "ONLINE" | "POS" | "BOTH"
  active    Boolean   @default(true) @map("active")
  usageCount Int      @default(0) @map("usage_count")
  createdBy String?   @db.VarChar(64) @map("created_by")
  createdAt DateTime  @default(now()) @db.Timestamp(0) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamp(3) @map("updated_at")

  @@map("promo_codes")
}

/// One redemption per order (orderId @unique = the idempotency key across
/// webhook / mark-as-paid / POS-cash "paid" paths). status lifecycle:
/// RESERVED at checkout -> APPLIED when the order is paid/confirmed,
/// RELEASED on cancel/expire (returns the use by decrementing usageCount).
/// Plain scalars, no database-level foreign keys (same precedent above).
model PromoRedemption {
  id             String   @id @db.VarChar(64) @map("id")
  promoId        String   @db.VarChar(64) @map("promo_id")
  orderId        String   @unique @db.VarChar(64) @map("order_id")
  customerId     String?  @db.VarChar(64) @map("customer_id")
  discountAmount Decimal  @db.Decimal(10, 2) @map("discount_amount")
  status         String   @default("RESERVED") @db.VarChar(10) @map("status")
  createdAt      DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@index([promoId, status], map: "promo_redemptions_promo_status_idx")
  @@index([customerId, status], map: "promo_redemptions_customer_status_idx")
  @@map("promo_redemptions")
}

model SyncIdempotencyKey {
  key        String   @id @db.VarChar(128)
  category   String   @db.VarChar(32) // "order", "payment", "stock_transaction", "cash_transaction", "expense", "shift"
  recordId   String   @db.VarChar(64) @map("record_id")
  createdAt  DateTime @default(now()) @db.Timestamp(0) @map("created_at")

  @@map("sync_idempotency_keys")
}
